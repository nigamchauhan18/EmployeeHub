<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmployeeHub - <%= title %></title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    <main class="login-page">
        <div class="login-wrapper">
            <section class="login-brand">
                <div class="brand-glow glow-one"></div>
                <div class="brand-glow glow-two"></div>
                <div class="brand-content">
                    <div class="brand-label">
                        <span></span>EMPLOYEE MANAGEMENT SYSTEM
                    </div>
                    <h1>Welcome back. <strong>Manage smarter.</strong></h1>
                    <p class="brand-description">Sign in to EmployeeHub and manage your employees, records, departments and daily operations from one simple workspace.</p>
                    <div class="brand-features">
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <div>
                                <strong>Employee Management</strong>
                                <span>Manage employee information from one place.</span>
                            </div>
                        </div>
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <div>
                                <strong>Simple Operations</strong>
                                <span>Keep your everyday management organized.</span>
                            </div>
                        </div>
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <strong>Secure Access</strong>
                                <span>Access your workspace with secure login.</span>
                            </div>
                        </div>
                    </div>
                    <div class="brand-bottom">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Everything your team needs, all in one place.</span>
                    </div>
                </div>
            </section>
            <section class="login-section">
                <div class="login-card">
                    <div class="login-logo">
                        <div class="logo-box">EH</div>
                        <div>
                            <strong>EmployeeHub</strong>
                            <span>Employee Management System</span>
                        </div>
                    </div>
                    <div class="login-header">
                        <div class="login-icon">
                            <i class="fa-solid fa-right-to-bracket"></i>
                        </div>
                        <div>
                            <h2>Welcome back</h2>
                            <p>Sign in to continue to your EmployeeHub account.</p>
                        </div>
                    </div>
                    <form id="loginForm">
                        <div class="login-group">
                            <label for="loginEmail">Email Address</label>
                            <div class="login-input">
                                <i class="fa-regular fa-envelope"></i>
                                <input type="email" id="loginEmail" name="email" placeholder="Enter your email">
                            </div>
                            <small id="emailError"></small>
                        </div>
                        <div class="login-group">
                            <div class="password-label">
                                <label for="loginPassword">Password</label>
                                <a href="/forgotpassword">Forgot password?</a>
                            </div>
                            <div class="login-input">
                                <i class="fa-solid fa-lock"></i>
                                <input type="password" id="loginPassword" name="password" placeholder="Enter your password">
                                <button type="button" class="password-toggle" id="passwordToggle">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <small id="passwordError"></small>
                        </div>
                        <label class="remember-me">
                            <input type="checkbox" id="rememberMe">
                            <span>Remember me</span>
                        </label>
                        <small id="rememberMeError"></small>
                        <button type="submit" class="login-button">Sign In
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </form>
                    <div class="signup-text">Don't have an account? <a href="/signup">Create an account</a></div>
                    <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i>Back to EmployeeHub</a>
                    <div class="security-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Your login information is securely protected.</span>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <div class="success-toast" id="successToast">
        <div class="toast-icon">
            <i class="fa-solid fa-check"></i>
        </div>
        <div class="toast-content">
            <strong>Login Successful</strong>
            <span>Welcome to EmployeeHub!</span>
        </div>
        <button type="button" class="toast-close" id="toastClose">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <script src="/js/login.js"></script>
</body>
</html>