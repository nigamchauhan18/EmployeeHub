<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmployeeHub - <%= title %></title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/forgotPassword.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    <main class="forgot-page">
        <div class="forgot-wrapper">
            <section class="forgot-brand">
                <div class="brand-glow glow-one"></div>
                <div class="brand-glow glow-two"></div>
                <div class="brand-content">
                    <div class="brand-label">
                        <span></span>EMPLOYEE MANAGEMENT SYSTEM
                    </div>
                    <h1>Forgot your password? <strong>We've got you covered.</strong></h1>
                    <p class="brand-description">Don't worry. Enter the email address associated with your EmployeeHub account and we'll help you get back into your account.</p>
                    <div class="brand-features">
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <strong>Enter Your Email</strong>
                                <span>Tell us the email connected to your account.</span>
                            </div>
                        </div>
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-link"></i>
                            </div>
                            <div>
                                <strong>Reset Your Password</strong>
                                <span>Follow the password reset instructions.</span>
                            </div>
                        </div>
                        <div class="brand-feature">
                            <div class="feature-icon">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <strong>Secure Recovery</strong>
                                <span>Your account recovery process stays protected.</span>
                            </div>
                        </div>
                    </div>
                    <div class="brand-bottom">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Get back to managing your team with EmployeeHub.</span>
                    </div>
                </div>
            </section>
            <section class="forgot-section">
                <div class="forgot-card">
                    <div class="forgot-logo">
                        <div class="logo-box">EH</div>
                        <div>
                            <strong>EmployeeHub</strong>
                            <span>Employee Management System</span>
                        </div>
                    </div>
                    <div class="forgot-header">
                        <div class="forgot-icon">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <div>
                            <h2>Forgot Password?</h2>
                            <p>Enter your email to reset your password.</p>
                        </div>
                    </div>
                    <form id="forgotPasswordForm">
                        <div class="forgot-group">
                            <label for="forgotEmail">Email Address</label>
                            <div class="forgot-input">
                                <i class="fa-regular fa-envelope"></i>
                                <input type="email" id="forgotEmail" name="email" placeholder="Enter your email address">
                            </div>
                            <small id="emailError"></small>
                        </div>
                        <div class="forgot-group">
                            <label for="newPassword">New Password</label>
                            <div class="forgot-input">
                                <i class="fa-solid fa-lock"></i>
                                <input type="password" id="newPassword" name="password" placeholder="Enter new password">
                                <button type="button" class="password-toggle" id="passwordToggle">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <small id="newPasswordError"></small>
                        </div>
                        <button type="submit" class="reset-button">Send Reset Password<i class="fa-solid fa-arrow-right"></i></button>
                    </form>
                    <div class="login-text">
                        Remember your password?
                        <a href="/login">Back to Login</a>
                    </div>
                    <a href="/" class="back-link">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to EmployeeHub
                    </a>
                    <div class="security-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Your account information is securely protected.</span>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <div class="success-toast" id="successToast">
        <div class="toast-icon">
            <i class="fa-solid fa-check"></i>
        </div>
        <div class="toast-content">
            <strong>Forgot Password Successful</strong>
            <span>Now, you can login.</span>
        </div>
        <button type="button" class="toast-close" id="toastClose">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <script src="/js/forgotPassword.js"></script>
</body>
</html>