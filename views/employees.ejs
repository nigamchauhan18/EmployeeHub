                    <thead>
                        <tr>
                            <th>EMPLOYEE</th>
                            <th>ID</th>
                            <th>DEPARTMENT</th>
                            <th>POSITION</th>
                            <th>SALARY</th>
                            <th>JOINED</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
