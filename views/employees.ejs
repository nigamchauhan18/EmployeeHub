    <div class="delete-modal-overlay" id="deleteModal">
        <div class="delete-modal">
            <div class="delete-modal-icon">
                <i class="fa-regular fa-trash-can"></i>
            </div>
            <h3>Delete Employee?</h3>
            <p>Are you sure you want to delete <strong id="deleteEmployeeName">this employee</strong>? This action cannot be undone.</p>
            <div class="delete-modal-actions">
                <button type="button" class="cancel-delete" id="cancelDelete">Cancel</button>
                <button type="button" class="confirm-delete" id="confirmDelete"><i class="fa-regular fa-trash-can"></i>Delete</button>
            </div>
        </div>
    </div>
    <!-- Edit Employee Modal -->
    <div class="edit-modal-overlay" id="editEmployeeModal">
        <div class="edit-modal">
            <div class="edit-modal-header">
                <div>
                    <span class="edit-modal-label">EMPLOYEE MANAGEMENT</span>
                    <h2>Edit Employee</h2>
                    <p>Update the employee's information below.</p>
                </div>
                <button type="button" class="edit-modal-close" id="closeEditModal" aria-label="Close edit form">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form id="editEmployeeForm">
                <input type="hidden" id="editEmpID">
                <div class="edit-form-grid">
                    <div class="edit-form-group">
                        <label for="editEmpName">Full Name</label>
                        <input type="text" id="editEmpName" required maxlength="100" autocomplete="name">
                    </div>
                    <div class="edit-form-group">
                        <label for="editEmpEmail">Email Address</label>
                        <input type="email" id="editEmpEmail" required maxlength="254" autocomplete="email">
                    </div>
                    <div class="edit-form-group">
                        <label for="editEmpDepartment">Department</label>
                        <select id="editEmpDepartment" required>
                            <option value="">Select Department</option>
                            <option value="Development">Development</option>
                            <option value="HR">HR</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Finance">Finance</option>
                            <option value="Design">Design</option>
                        </select>
                    </div>
                    <div class="edit-form-group">
                        <label for="editEmpPosition">Position</label>
                        <input type="text" id="editEmpPosition" required maxlength="100">
                    </div>
                    <div class="edit-form-group">
                        <label for="editEmpSalary">Monthly Salary (₹)</label>
                        <input type="number" id="editEmpSalary" required min="0" step="1">
                    </div>
                    <div class="edit-form-group">
                        <label for="editEmpJoined">Joining Date</label>
                        <input type="date" id="editEmpJoined" required>
                    </div>
                    <div class="edit-form-group edit-full-width">
                        <label for="editEmpStatus">Employment Status</label>
                        <select id="editEmpStatus" required>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="edit-modal-actions">
                    <button type="button" class="edit-cancel-btn" id="cancelEditEmployee">Cancel</button>
                    <button type="submit" class="edit-save-btn">
                        <i class="fa-regular fa-floppy-disk"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- View Employee Modal -->
    <div class="view-employee-modal" id="viewEmployeeModal">
        <div class="view-employee-content">
            <div class="view-employee-header">
                <div>
                    <h2>Employee Details</h2>
                    <p>View complete employee information</p>
                </div>
                <button type="button" class="view-close-btn" id="closeViewModal" aria-label="Close employee details">
                    &times;
                </button>
            </div>
            <div class="view-employee-profile">
                <div class="view-profile-avatar" id="viewEmpAvatar">E</div>
                <div>
                    <h3 id="viewEmpName">Employee Name</h3>
                    <p id="viewEmpPosition">Employee Position</p>
                    <span id="viewEmpStatus" class="view-status-badge">Active</span>
                </div>
            </div>
            <div class="view-employee-details">    
                <div class="view-detail-item">
                    <span>Employee ID</span>
                    <p id="viewEmpID">—</p>
                </div>
                <div class="view-detail-item">
                    <span>Full Name</span>
                    <p id="viewEmpFullName">—</p>
                </div>
                <div class="view-detail-item">
                    <span>Email Address</span>
                    <p id="viewEmpEmail">—</p>
                </div>    
                <div class="view-detail-item">
                    <span>Department</span>
                    <p id="viewEmpDepartment">—</p>
                </div>
                <div class="view-detail-item">
                    <span>Position</span>
                    <p id="viewEmpJobPosition">—</p>
                </div>    
                <div class="view-detail-item">
                    <span>Salary</span>
                    <p id="viewEmpSalary">—</p>
                </div>
                <div class="view-detail-item">
                    <span>Joining Date</span>
                    <p id="viewEmpJoined">—</p>
                </div>
            </div>
            <div class="view-employee-footer">
                <button type="button" class="view-done-btn" id="doneViewEmployee">
                    Close
                </button>
            </div>
        </div>
    </div>
